# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN DE EJEMPLO PARA EL PIPELINE CI/CD (GoVet)
# ==============================================================================
# Copia este archivo como '.env' en la raíz de tu proyecto para configuraciones locales:
# cp .env.example .env
#
# NOTA: En GitHub Actions, estas variables se configurarán en GitHub Secrets.

# ------------------------------------------------------------------------------
# 1. Credenciales de Acceso a Docker Hub / Registry
# ------------------------------------------------------------------------------
# Tu nombre de usuario en Docker Hub o tu registro privado
DOCKER_USERNAME=

# Contraseña o Access Token del registro Docker
DOCKER_PASSWORD=

# Servidor del registro Docker (dejar vacío si se usa Docker Hub oficial)
DOCKER_REGISTRY=

# ------------------------------------------------------------------------------
# 2. Configuración de Imágenes Docker
# ------------------------------------------------------------------------------
# Nombre de la imagen del backend (ej. tunombreusuario/govet-backend)
BACKEND_IMAGE=govet-backend

# Nombre de la imagen del frontend (ej. tunombreusuario/govet-frontend)
FRONTEND_IMAGE=govet-frontend

# Tag de la versión para el build y despliegue (ej. latest, v1.0.0, etc.)
IMAGE_TAG=latest
